# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file IS committed to version control — never put real secrets in it.
#
# When adding additional environment variables, update the schema in
# "/src/env.js" accordingly.

# ─── Next Auth ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel/host env vars — use https, no trailing slash):
# NEXTAUTH_URL="https://www.azziop.com"
# AUTH_URL="https://www.azziop.com"
AUTH_TRUST_HOST="true"
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Add EVERY redirect URI you use (local + prod, www + non-www if both work):
#   http://localhost:3000/api/auth/callback/google
#   https://www.azziop.com/api/auth/callback/google
#   https://azziop.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/dbname"

# ─── AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Razorpay (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) ───
# Get test keys from: https://dashboard.razorpay.com/app/keys
# SECURITY: KEY_SECRET must NEVER be in frontend code or NEXT_PUBLIC_* vars.
# Standard Checkout API routes (auth required):
#   POST /api/create-order   → { order_id, amount, currency, key_id }
#   POST /api/verify-payment → { razorpay_order_id, razorpay_payment_id, razorpay_signature }
# Product checkout also uses /api/billing/subscribe, /api/billing/credits, /checkout
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# REQUIRED for recurring billing + idempotent grants. Set the same value in the
# Razorpay dashboard webhook (events: subscription.activated/charged/halted/
# cancelled/completed, payment.captured). Webhook URL: {host}/api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=""
# Razorpay Subscription Plan IDs — create one plan per tier×interval in the
# Razorpay dashboard, then paste the plan_id here. Charged amount lives in Razorpay.
RAZORPAY_PLAN_STARTER_MONTHLY=""
RAZORPAY_PLAN_STARTER_YEARLY=""
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_PRO_YEARLY=""
RAZORPAY_PLAN_AGENCY_MONTHLY=""
RAZORPAY_PLAN_AGENCY_YEARLY=""

# ─── Meta / Instagram (for scheduler) ───────────────────────
META_APP_ID=""
META_APP_SECRET=""

# ─── Cron jobs (optional) ───────────────────────────────────
# Protects GET/POST /api/cron/publish-due on production. VPS example:
#   */5 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://www.azziop.com/api/cron/publish-due
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ─── Client-side (safe to expose) ───────────────────────────
# Anything below this line is shipped to the browser. Never put a secret here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
