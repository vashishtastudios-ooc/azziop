# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file IS committed to version control — never put real secrets in it.
#
# When adding additional environment variables, update the schema in
# "/src/env.js" accordingly.

# ─── Next Auth ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Google OAuth (Gmail sign-in) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/dbname"

# ─── AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Razorpay (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) ───
# SECURITY: the key_secret must NEVER be exposed to the browser.
# The key_id is safe to send to the client via the subscribe endpoint,
# but we still keep it server-side so rotation is a single source of truth.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Optional — only needed once you migrate from one-time orders to
# Razorpay Subscriptions (recurring billing).
RAZORPAY_PLAN_STARTER_MONTHLY=""
RAZORPAY_PLAN_STARTER_YEARLY=""
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_PRO_YEARLY=""
RAZORPAY_PLAN_AGENCY_MONTHLY=""
RAZORPAY_PLAN_AGENCY_YEARLY=""

# ─── Meta / Instagram (for scheduler) ───────────────────────
META_APP_ID=""
META_APP_SECRET=""

# ─── Cron jobs ──────────────────────────────────────────────
# Required on deployed production (Vercel/host) for /api/cron/* — optional for local build.
# On Vercel, set this in the project env vars — Vercel Cron will pass it
# automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ─── Client-side (safe to expose) ───────────────────────────
# Anything below this line is shipped to the browser. Never put a secret here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
